{
  "outputDirectory": "public",
  "functions": {
    "api/notion.js": {
      "maxDuration": 15
    },
    "api/progress-photos.js": {
      "maxDuration": 15
    },
    "api/sync-notion.js": {
      "maxDuration": 60
    },
    "api/coach-data.js": {
      "maxDuration": 30
    },
    "api/athletes.js": {
      "maxDuration": 30
    },
    "api/actions.js": {
      "maxDuration": 15
    },
    "api/analyse.js": {
      "maxDuration": 45
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/sync-notion",
      "schedule": "0 4 * * *"
    }
  ]
}
